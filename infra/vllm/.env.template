# vLLM/.env.template — copier vers `.env` puis ajuster les valeurs.
# `.env` est ignore par git (voir `.gitignore`) : ne jamais y mettre de secret versionne.
#
# DEFaut = la seule config mesuree qui PRODUIT une generation sur cette machine
# (2026-10-19, WSL2 / Ubuntu 24.04, RTX 5090 32 Go) : image epinglee par digest
# (vLLM 0.24.0), FP8 a la volee, sans offload CPU. AVERTISSEMENTS :
#   * le texte genere est DEGENERE (smoke_chat.py -> FAIL) : voir
#     vLLM/KNOWN_ISSUES.md (E2/E3) — aucun verdict qualite n'est pose ;
#   * toute comparaison Jainius / D_p faite avec ce defaut est en FP8, PAS en
#     BF16 (le modele en BF16 ne tient pas dans 31,84 GiB de VRAM) ;
#   * l'image `gemma` (support natif DiffusionGemma, PR #45163) est
#     INUTILISABLE sous WSL2 : UVA indisponible -> runner V2 impossible a
#     l'init ; runner V1 -> crash a la 1re generation.
# CUDA >= 12.9 requis (Blackwell).

# Image vLLM officielle, EINGLEE PAR DIGEST (reproductible) : tag `latest` au
# 2026-10-19 = vLLM 0.24.0.
VLLM_IMAGE=vllm/vllm-openai@sha256:251eba5cc7c12fed0b75da22a9240e582b1c9e39f6fbc064f86781b963bd814f

# Chemin HOTE du checkpoint (tel que vu depuis WSL, ou Docker y accede).
# Defaut : le Jainius de ce repo (montage relatif au docker-compose.yml).
# Si le chargement des ~52 Go via /mnt/d est trop lent, copier le checkpoint
# dans le FS WSL (ex. ~/models/Jainius) et mettre ce chemin ici.
VLLM_MODEL_HOST_PATH=../checkpoints/Jainius

# Nom de modele expose par l'API OpenAI-compatible.
VLLM_SERVED_MODEL_NAME=jainius

# Port HTTP expose sur l'hote.
VLLM_PORT=8000

# Token HuggingFace. Optionnel (checkpoint 100 % local).
# Requis seulement si un tokenizer/modele gate doit etre telecharge.
# Peut reprendre la valeur du `.env` racine.
HF_TOKEN=

# Precision des ACTIVATIONS et du calcul. "bfloat16" = fidelite max.
# "fp8" ici exige un checkpoint PRE-quantifie FP8 (non fourni) : pour
# quantifier a la volee un checkpoint BF16, utiliser le flag
# --quantization fp8 (cf. VLLM_EXTRA_ARGS plus bas), pas cette variable.
VLLM_DTYPE=bfloat16

# Go de weights MoE delestes vers la RAM CPU (flag vLLM --cpu-offload-gb).
# 0 = tout reste en VRAM. Les poids font 48,10 GiB (BF16) / 25,85 GiB (FP8) ;
# la RAM de WSL2 ne fait que 30 GiB au total (~29 GiB disponibles) -> un
# offload de 30 Go sature la machine (swap 7,9 GiB, mesure du 2026-10-19).
# D'ou le defaut 0 + quantification FP8.
VLLM_CPU_OFFLOAD_GB=0

# Longueur de contexte max (VRAM). 2048 : le canvas de diffusion fait 256
# tokens, la place restante sert au cache KV (2,57 GiB mesures en FP8).
VLLM_MAX_MODEL_LEN=2048

# Sequences concurrentes. 1 pour l'eval (reproductible, sobre en VRAM).
VLLM_MAX_NUM_SEQS=1

# Fraction VRAM utilisable par vLLM (0.92 = marge pour le sampler diffusion ;
# 0,92 x 31,84 GiB = 29,29 GiB de budget, contre 25,85 GiB de poids FP8).
VLLM_GPU_MEMORY_UTILIZATION=0.92

# === Configuration WSL2 (voir vLLM/KNOWN_ISSUES.md, incidents 2026-10-18/19) ===

# Memoire einglee sous WSL2 : c'est elle qui permet l'UVA, donc le runner V2.
# CONNUE de l'image 0.24.0 (celle du defaut) -> la laisser a 1. INCONNUE de
# l'image `gemma` (0.22.1rc1), qui refuse de toute facon la memoire einglee
# sous WSL -> runner V2 impossible avec cette image.
#VLLM_WSL2_ENABLE_PIN_MEMORY=1

# Debug GPU : 1 = synchronise les lances CUDA (ralentit, mais localise le vrai
# point de crash ; les erreurs CUDA sont asynchrones). Defaut : 0.
#CUDA_LAUNCH_BLOCKING=1

# 1 = passe --enforce-eager (pas de CUDA graphs). Defaut : 1.
#VLLM_ENFORCE_EAGER=1

# Forcer le runner V1. INUTILE ici : le 2026-10-18 (runner V1 force) a charge
# le modele mais la 1re generation a plante (assert GPU scatter/gather ; cause
# identifiee le 2026-10-19 : index -1 dans le scatter de `_prepare_input_ids`,
# lie au canvas de diffusion lu comme une liste de draft tokens).
# Laisser vide = comportement par defaut de vLLM (runner V2).
#VLLM_USE_V2_MODEL_RUNNER_OVERRIDE=0

# Arguments vLLM supplementaires. Decoupes par le shell du conteneur (le
# compose passe le script complet a `bash -c` apres avoir neutralise
# l'entrypoint ["vllm","serve"] de l'image) : plusieurs flags separes par des
# espaces OK.
# `--quantization fp8` = QUANTIFICATION A LA VOLEE des poids BF16 du
# checkpoint (25,85 GiB en VRAM au lieu de 48,10 GiB). C'est la seule option
# qui tient dans 31,84 GiB de VRAM sans offload CPU -> toute generation faite
# avec ce defaut est EN FP8 (pas en BF16).
# Variante testee le 2026-10-19 (`fp8_per_channel`, echelle par canal de sortie
# au lieu de par tenseur) : pas de difference observee sur le texte.
# Autres exemples (a valider contre `vllm serve --help` de l'image) :
#   --limit-mm-per-prompt '{"image":0,"video":0}'   # limite le cache multimodal
VLLM_EXTRA_ARGS=--quantization fp8

# Allocation memoire PyTorch (variable d'environnement du CONTENEUR, pas un
# flag vLLM). Valeur VIDE = desactive (`expandable_segments` non utilise).
# C'est la valeur utilisee par la config mesuree le 2026-10-19 (E2/E3) ; le
# defaut du compose reste `expandable_segments:True` (reactivable ici).
# ATTENTION : la ligne doit rester presente (meme vide) ; la supprimer rend
# la variable non definie -> le compose reapplique son defaut.
PYTORCH_CUDA_ALLOC_CONF=

