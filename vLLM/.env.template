# vLLM/.env.template — copier vers `.env` puis ajuster les valeurs.
# `.env` est ignore par git (voir `.gitignore`) : ne jamais y mettre de secret versionne.

# Image vLLM officielle. Tag `gemma` epingle (support natif DiffusionGemma :
# vLLM PR #45163, blog vLLM "DiffusionGemma" du 2026-06-10, recipe 2026-09-23).
# Ne PAS utiliser `latest` (non reproductible). CUDA >= 12.9 requis (Blackwell).
VLLM_IMAGE=vllm/vllm-openai:gemma

# Chemin HOTE du checkpoint (tel que vu depuis WSL, ou Docker y accede).
# Defaut : le Jainius de ce repo (montage relatif au docker-compose.yml).
# Si le chargement des ~52 Go via /mnt/d est trop lent, copier le checkpoint
# dans le FS WSL (ex. ~/models/Jainius) et mettre ce chemin ici.
VLLM_MODEL_HOST_PATH=../checkpoints/Jainius

# Nom de modele expose par l'API OpenAI-compatible.
VLLM_SERVED_MODEL_NAME=jainius

# Port HTTP expose sur l'hote.
VLLM_PORT=8000

# Token HuggingFace. Optionnel (checkpoint 100 % local).
# Requis seulement si un tokenizer/modele gate doit etre telecharge.
# Peut reprendre la valeur du `.env` racine.
HF_TOKEN=

# Precision. "bfloat16" = fidelite max. "fp8" = ~2x moins de VRAM et plus
# rapide MAIS exige un checkpoint pre-quantifie FP8 (non fourni ici) :
# avec le Jainius BF16 actuel, laisser "bfloat16".
VLLM_DTYPE=bfloat16

# Go de weights MoE delestes vers la RAM CPU (flag vLLM --cpu-offload-gb).
# Jainius fait ~51.6 Go BF16 pour ~31 Go de VRAM : delester ~25-30 Go.
# RAM hote : ~67 Go, donc 30 est raisonnable. Baisser si OOM RAM.
VLLM_CPU_OFFLOAD_GB=30

# Longueur de contexte max (VRAM). 4096 par defaut pour 5090 32 Go.
# Baisser a 2048 si OOM, monter a 8192 si stable.
VLLM_MAX_MODEL_LEN=4096

# Sequences concurrentes. 1 pour l'eval (reproductible, sobre en VRAM).
VLLM_MAX_NUM_SEQS=1

# Fraction VRAM utilisable par vLLM (0.90 = marge pour sampler diffusion).
VLLM_GPU_MEMORY_UTILIZATION=0.90

# Arguments vLLM supplementaires (sampler diffusion, batch, etc.).
# Decoupes par le shell du conteneur (le compose passe le script complet a
# `bash -c` apres avoir neutralise l'entrypoint ["vllm","serve"] de l'image) :
# plusieurs flags separes par des espaces OK.
# Exemples (a valider contre `vllm serve --help` de l'image utilisee) :
#   --max-model-len 8192 --enable-prefix-caching
VLLM_EXTRA_ARGS=
